// Prisma schema for prevo server.
// All state/record amounts are quantities stored as Int (minimum unit 1).
// No money fields exist yet; if money appears later, store 100x the amount (cents).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  cycleStates   CycleState[]
  scopeRecords  ScopeRecord[]
  importedSales ImportedSale[]
  products      Product[]
}

// Imported historical sales: only used for sales prediction. They never
// touch the state machine, the ledger or the live position.
model ImportedSale {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  date      DateTime // local midnight, only the date part matters
  amount    Int      // total sales of that day
  createdAt DateTime @default(now())

  @@index([productId])
}

// A product type of a user. The id is the stable identity of the product;
// productType is only an editable display name (still unique per user).
model Product {
  id            Int           @id @default(autoincrement())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  productType   String
  orderMultiple Int           @default(1) // purchase qty must be a multiple; 1 = no constraint
  createdAt     DateTime      @default(now())
  cycleStates   CycleState[]
  scopeRecords  ScopeRecord[]
  importedSales ImportedSale[]

  @@unique([userId, productType])
  @@index([userId])
}

// One snapshot per (scope, cycle). scope = { userId, productId }.
model CycleState {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     Int
  cycle         Int
  inventory     Int
  soldTransit   Int
  boughtTransit Int
  sent          Int
  received      Int
  sale          Int
  purchase      Int
  createdAt     DateTime @default(now())

  @@unique([productId, cycle])
  @@index([productId])
}

// The ledger of a scope. Records are kept forever; a server-side cycle
// settlement (no client entry point) marks every pending record with the
// cycle it was folded into, so a record can never be folded twice.
// kind is one of: PURCHASE | SELL | SEND | RECEIVE
model ScopeRecord {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  kind      String
  amount    Int
  cycle     Int? // null = pending (not folded into any cycle yet)
  createdAt DateTime @default(now())

  @@index([productId])
}
