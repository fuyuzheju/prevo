# SQLite database file (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"
# Secret used to sign JWTs. Override in production.
JWT_SECRET="change-me-in-production"
# HTTP port
PORT=3000
# Daily cycle settlement moment (HH:MM, server local time). Records are folded
# per local calendar day, so 00:05 settles "yesterday".
# SETTLE_TIME="00:05"
# Interpreter used to run the sales predictor (server/python/main.py). It must
# have numpy and pandas importable, which is not guaranteed for whatever
# "python" resolves to first on PATH — a conda base env, for instance, can
# carry a broken pandas. Point this at a known-good environment.
# PREDICTOR_PYTHON="/path/to/python"
